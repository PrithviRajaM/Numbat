# NumbatUI environment configuration
#
# Copy this file to `.env` and adjust for your setup. Expo only exposes vars
# prefixed with EXPO_PUBLIC_ to the app bundle. Restart the dev server after
# changing these values.

# Base URL of the NumbatAPI backend (no trailing slash).
#   - Web / iOS simulator:   http://127.0.0.1:7531
#   - Android emulator:      http://10.0.2.2:7531
#   - Physical device:       http://<your-machine-LAN-IP>:7531
# If unset, the app picks a sensible per-platform default (see src/config).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:7531

# Set to "true" to use the in-memory mock auth service (no backend needed).
EXPO_PUBLIC_USE_MOCK_AUTH=false
